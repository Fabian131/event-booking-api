# Database Configuration
DATABASE_URL=postgresql+asyncpg://event_booking_user:your_password@localhost:5432/event_booking_db
POSTGRES_USER=event_booking_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=event_booking_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Event Booking API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# CORS Configuration (Expo default ports)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@eventbooking.com
SMTP_USE_TLS=true

# Admin Seed Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourAdminPassword123#
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=System
ADMIN_PHONE=12345678

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Push Notifications (Expo Push Service)
# How often the reminder job runs (in minutes). Default: 5
REMINDER_CHECK_INTERVAL_MINUTES=5
